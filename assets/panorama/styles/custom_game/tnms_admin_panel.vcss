/* tnms_admin_panel.vcss — TnmsAdminUtils admin panel (tnms_admin_panel.lxml).
 * liuli_skin.vcss is included first; rules here override its role defaults.
 * No flex/gap/scroll in Panorama: fixed-width columns flowing right, margins for spacing.
 * width / height include padding and border (measured in game). Inside the form everything is in px: % widths there
 * came out wider than the parent's inside. Card 1140 = sidebar 200 + main 940 (content 900). */

/* Between the menu (10500) and toasts (10800). z-index never hot-reloads. */
.lu-root {
	z-index: 10600;
}

/* The placement point is the card's top-left corner, as for every Liuli surface, so the !ui map matches.
 * (A negative margin-left on the band to center it had no effect; margin-top on the box did, which mixed the
 * axes.) Default placement 20 / 18 centers the 1140 x 700 card on the 1920 x 1080 Panorama canvas. */
.lu-box.tap-card {
	width: 1140px;
	height: 700px;
	padding: 0px;
}

/* Sidebar + main. The box itself does not flow, so the !ui name chip overlays instead of taking a slot. */
.tap-in {
	flow-children: down;
	width: 1140px;
	height: 700px;
}

/* !ui preview chip: lift it above the card so it does not cover the brand. */
.tap-card .lu-ptag {
	margin-top: -30px;
}

/* Hidden sections / rows / items. visibility (not opacity) so hidden panels do not hit-test. */
.tap-off {
	visibility: collapse;
}

/* Lists scrolled by Panorama on the client (wheel / bar; the bar is csgostyles' VerticalScrollBar). The server
   cannot set the position: it adds tap-sreset for a moment to bring a list back to the top. */
.tap-scroll {
	overflow: squish scroll;
}

.tap-scroll.tap-sreset {
	overflow: squish clip;
}

/* Hidden but keeping its place (prev / next at the ends). Still hit-tests; the server ignores those clicks. */
.tap-ghost {
	opacity: 0;
}

/* ---- header bar ---- */
.tap-top {
	flow-children: right;
	width: 1140px;
	height: 48px;
	background-color: #1a2330e6;
	border-bottom: 1px solid #ffffff14;
}

/* As wide as the sidebar, so the pages start where the main area does. */
.tap-brand {
	width: 200px;
	height: 47px;
	padding: 13px 0px 0px 20px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 18px;
	letter-spacing: 1px;
	color: #ffde85;
}

.tap-nav {
	height: 47px;
	padding: 0px 18px;
	border-bottom: 3px solid #00000000;
}

.tap-nav:hover {
	background-color: #41567a99;
}

.tap-nav.tap-sel {
	background-color: #2e3c50;
	border-bottom: 3px solid #ffde85;
}

.tap-nav-t {
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 16px;
	color: #c5ccd3;
	white-space: nowrap;
}

.tap-nav:hover .tap-nav-t, .tap-nav.tap-sel .tap-nav-t {
	color: #ffeaa8;
}

/* Takes the space between the pages and Close, text at its right end. */
.tap-hint {
	width: fill-parent-flow( 1.0 );
	vertical-align: center;
	margin-right: 16px;
	text-align: right;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #6b747d;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-close {
	height: 47px;
	padding: 0px 22px;
	border-left: 1px solid #ffffff14;
}

.tap-close:hover {
	background-color: #8a3a3a99;
}

.tap-close-t {
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 16px;
	color: #c5ccd3;
}

.tap-close:hover .tap-close-t {
	color: #ffffff;
}

/* Sidebar + main under the header bar. */
.tap-body {
	flow-children: right;
	width: 1140px;
	height: fill-parent-flow( 1.0 );
}

/* ---- sidebar ---- */
/* The same 4px between the header bar / the bottom and the up / down buttons. */
.tap-side {
	flow-children: down;
	width: 200px;
	height: 100%;
	padding: 4px 0px;
	background-color: #1a2330e6;
	border-right: 1px solid #ffffff14;
}

/* The sidebar's whole height (Previous / Next included); scrolls. */
.tap-slist {
	flow-children: down;
	width: 199px;
	height: fill-parent-flow( 1.0 );
}

/* Sidebar 200 - its border-right 1. */
/* 10 on the left (the icon near the edge), 18 on the right. */
.tap-si {
	flow-children: right;
	width: 199px;
	height: 38px;
	padding: 0px 18px 0px 10px;
	border-left: 3px solid #00000000;
	overflow: noclip noclip;
}

.tap-si:hover {
	background-color: #41567a99;
}

.tap-si.tap-sel {
	background-color: #2e3c50;
	border-left: 3px solid #ffde85;
}

/* Icon, then the label 8 px after it. The icon panel sits at the same place on every item (indenting moves only the label) and
   shows one of CS2's own UI icons as its background (ico-<name> on the item, rules below) or a glyph in its label
   (tap-ig). Both are tinted by wash-color: grey, gold on hover / selected. Glyphs come from different fallback fonts:
   tap-ico-s / -l on the item correct a glyph's size, and one wider than the box shrinks to fit. */
.tap-si-i, .tap-sbtn-i {
	width: 22px;
	height: 20px;
	margin-right: 8px;
	vertical-align: center;
	background-repeat: no-repeat;
	background-position: 50% 50%;
	background-size: 18px 18px;
	wash-color: #9aa4af;
}

.tap-si:hover .tap-si-i, .tap-si.tap-sel .tap-si-i, .tap-sbtn:hover .tap-sbtn-i {
	wash-color: #ffde85;
}

.tap-ig {
	width: 100%;
	height: 100%;
	text-align: center;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 16px;
	color: #ffffff;
	white-space: nowrap;
	text-overflow: shrink min( 8px ) ellipsis;
}

.tap-ico-s .tap-ig {
	font-size: 13px;
}

.tap-ico-l .tap-ig {
	font-size: 19px;
}

/* Previous / Next: arrowhead (pointing up) as it is / turned down. */
.tap-ico-up .tap-sbtn-i, .tap-ico-down .tap-sbtn-i {
	background-image: url("s2r://panorama/images/icons/ui/arrowhead.vsvg");
	background-size: 12px 12px;
}

.tap-ico-down .tap-sbtn-i {
	transform: rotateZ( 180deg );
}

.tap-si:hover .tap-si-i, .tap-si.tap-sel .tap-si-i, .tap-sbtn:hover .tap-sbtn-i {
	color: #ffde85;
}

/* After the icon (22 + 8); long labels shrink to fit. */
.tap-si-t {
	width: 120px;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 16px;
	color: #c5ccd3;
	white-space: nowrap;
	text-overflow: shrink min( 12px ) ellipsis;
}

.tap-si:hover .tap-si-t, .tap-si.tap-sel .tap-si-t {
	color: #ffeaa8;
}

/* Items under a heading. */
/* Items under a heading: the label steps in, the icon stays in its column. */
.tap-si.tap-ind .tap-si-t {
	margin-left: 10px;
	width: 110px;
}

/* A heading: not an item, no hover. */
.tap-si.tap-sih, .tap-si.tap-sih:hover {
	height: 32px;
	margin-top: 6px;
	background-color: #00000000;
	border-left: 3px solid #00000000;
}

/* Headings have no icon: the label takes its place. */
.tap-si.tap-sih .tap-si-i {
	visibility: collapse;
}

.tap-si.tap-sih .tap-si-t, .tap-si.tap-sih:hover .tap-si-t {
	width: 142px;
	vertical-align: bottom;
	margin-bottom: 6px;
	font-size: 12px;
	letter-spacing: 1px;
	color: #9aa4af;
}

/* Previous / Next as the list's first / last entries, only when there is a page that way. Shaped like an item, told
   apart by a tinted background, a line towards the items and a gold hover. */
.tap-sbtn {
	flow-children: right;
	width: 199px;
	height: 38px;
	padding: 0px 18px 0px 10px;
	background-color: #ffffff0a;
	border-left: 3px solid #00000000;
}

.tap-sbtn-prev {
	border-bottom: 1px solid #ffffff14;
}

.tap-sbtn-next {
	border-top: 1px solid #ffffff14;
}

.tap-sbtn:hover {
	background-color: #ffde8514;
	border-left: 3px solid #ffde8599;
}

.tap-sbtn-t {
	width: 120px;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-sbtn:hover .tap-sbtn-t {
	color: #ffde85;
}

/* CS2's own UI icons by name (AdminPanelIcons.Names). */
.ico-addplayer .tap-si-i, .ico-addplayer .tap-sbtn-i { background-image: url("s2r://panorama/images/icons/ui/addplayer.vsvg"); }
.ico-alert .tap-si-i, .ico-alert .tap-sbtn-i { background-image: url("s2r://panorama/images/icons/ui/alert.vsvg"); }
