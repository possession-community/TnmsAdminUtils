/* tnms_admin_panel.vcss — TnmsAdminUtils admin panel (tnms_admin_panel.lxml).
 * liuli_skin.vcss is included first; rules here override its role defaults.
 * No flex/gap/scroll in Panorama: fixed-width columns flowing right, margins for spacing.
 * width / height include padding and border (measured in game). Inside the form everything is in px: % widths there
 * came out wider than the parent's inside. Card 1140 = sidebar 200 + main 940 (content 900). */

/* Between the menu (10500) and toasts (10800). z-index never hot-reloads. */
.lu-root {
	z-index: 10600;
}

/* The placement point is the card's top-left corner, as for every Liuli surface, so the !ui map matches.
 * (A negative margin-left on the band to center it had no effect; margin-top on the box did, which mixed the
 * axes.) Default placement 20 / 18 centers the 1140 x 700 card on the 1920 x 1080 Panorama canvas. */
.lu-box.tap-card {
	width: 1140px;
	height: 700px;
	padding: 0px;
}

/* Sidebar + main. The box itself does not flow, so the !ui name chip overlays instead of taking a slot. */
.tap-in {
	flow-children: right;
	width: 1140px;
	height: 700px;
}

/* !ui preview chip: lift it above the card so it does not cover the brand. */
.tap-card .lu-ptag {
	margin-top: -30px;
}

/* Hidden sections / rows / items. visibility (not opacity) so hidden panels do not hit-test. */
.tap-off {
	visibility: collapse;
}

/* ---- sidebar ---- */
.tap-side {
	flow-children: down;
	width: 200px;
	height: 100%;
	background-color: #1a2330e6;
	border-right: 1px solid #ffffff14;
}

.tap-brand {
	margin: 16px 18px 18px 18px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 18px;
	letter-spacing: 1px;
	color: #ffde85;
}

/* Sidebar 200 - its border-right 1. */
.tap-nav {
	width: 199px;
	height: 38px;
	padding: 0px 18px;
	border-left: 3px solid #00000000;
	overflow: noclip noclip;
}

.tap-nav:hover {
	background-color: #41567a99;
}

.tap-nav.tap-sel {
	background-color: #2e3c50;
	border-left: 3px solid #ffde85;
}

/* 142 = button 199 - padding 2 x 18 - border-left 3; long labels ("Notification Commands") shrink to fit. */
.tap-nav-t {
	width: 142px;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 16px;
	color: #c5ccd3;
	white-space: nowrap;
	text-overflow: shrink min( 12px ) ellipsis;
}

.tap-nav:hover .tap-nav-t, .tap-nav.tap-sel .tap-nav-t {
	color: #ffeaa8;
}

.tap-nav-close {
	margin-top: 18px;
	border-top: 1px solid #ffffff14;
}

/* ---- main ---- */
.tap-main {
	flow-children: down;
	width: 940px;
	height: 100%;
	padding: 0px 20px;
}

.tap-head {
	flow-children: down;
	width: 900px;
	margin-top: 16px;
	padding-bottom: 10px;
	margin-bottom: 12px;
	border-bottom: 1px solid #ffffff14;
}

.tap-title {
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 22px;
	color: #f4f6f8;
	text-overflow: shrink min( 12px ) ellipsis;
	white-space: nowrap;
}

.tap-sub {
	margin-top: 2px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	text-overflow: shrink min( 10px ) ellipsis;
	white-space: nowrap;
}

/* Takes whatever height the header and footer leave, so the card has no empty band at the bottom. */
.tap-sec {
	flow-children: down;
	width: 900px;
	height: fill-parent-flow( 1.0 );
}

/* ---- overview ---- */
.tap-ov-row {
	flow-children: right;
	width: 900px;
	margin-bottom: 12px;
}

/* 4 x 216 + 3 x 12 = 900. */
.tap-stat {
	flow-children: down;
	width: 216px;
	height: 96px;
	margin-right: 12px;
	padding: 12px 14px;
	background-color: #2e3c50cc;
	border: 1px solid #ffffff14;
	border-left: 3px solid #ffde85;
}

.tap-stat:last-child {
	margin-right: 0px;
}

.tap-stat-k {
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-stat-v {
	margin-top: 8px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 26px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 12px ) ellipsis;
}

/* ---- users table ---- */
.tap-urow {
	flow-children: right;
	width: 900px;
	height: 26px;
	padding: 0px 6px;
	overflow: noclip noclip;
}

Button.tap-urow:hover {
	background-color: #41567a99;
}

.tap-urow:nth-child(odd) {
	background-color: #ffffff08;
}

.tap-urow.tap-uhead {
	height: 30px;
	border-bottom: 1px solid #ffffff1f;
	background-color: #00000000;
}

.tap-cell {
	width: 120px;
	vertical-align: center;
	padding-right: 8px;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

/* Header cells: same pitch as the data cells, but the hover box is inset 4px on both sides of the text
 * (shifted left by 4px and padded back) instead of hanging the cell's 8px right gap off the text. */
.tap-hcell {
	height: 24px;
	vertical-align: center;
	margin: 0px 4px 0px -4px;
	padding: 0px 4px;
}

.tap-hcell-t {
	width: 100%;
	vertical-align: center;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-hcell.tap-sortable:hover {
	background-color: #41567a66;
}

.tap-hcell.tap-sortable:hover .tap-hcell-t {
	color: #ffeaa8;
}

.tap-hcell.tap-sorted .tap-hcell-t {
	color: #ffde85;
}

Button.tap-urow:hover .tap-cell {
	color: #ffeaa8;
}

/* Column width ladder: set on #tap-us as w{slot}-{x|xs|s|m|l|xl}. id + class beats .tap-cell. */
#tap-us.w0-x .tap-c0 { visibility: collapse; }
#tap-us.w0-xs .tap-c0 { width: 50px; }
#tap-us.w0-s .tap-c0 { width: 70px; }
#tap-us.w0-m .tap-c0 { width: 120px; }
#tap-us.w0-l .tap-c0 { width: 164px; }
#tap-us.w0-xl .tap-c0 { width: 230px; }
#tap-us.w1-x .tap-c1 { visibility: collapse; }
#tap-us.w1-xs .tap-c1 { width: 50px; }
#tap-us.w1-s .tap-c1 { width: 70px; }
#tap-us.w1-m .tap-c1 { width: 120px; }
#tap-us.w1-l .tap-c1 { width: 164px; }
#tap-us.w1-xl .tap-c1 { width: 230px; }
#tap-us.w2-x .tap-c2 { visibility: collapse; }
#tap-us.w2-xs .tap-c2 { width: 50px; }
#tap-us.w2-s .tap-c2 { width: 70px; }
#tap-us.w2-m .tap-c2 { width: 120px; }
#tap-us.w2-l .tap-c2 { width: 164px; }
#tap-us.w2-xl .tap-c2 { width: 230px; }
#tap-us.w3-x .tap-c3 { visibility: collapse; }
#tap-us.w3-xs .tap-c3 { width: 50px; }
#tap-us.w3-s .tap-c3 { width: 70px; }
#tap-us.w3-m .tap-c3 { width: 120px; }
#tap-us.w3-l .tap-c3 { width: 164px; }
#tap-us.w3-xl .tap-c3 { width: 230px; }
#tap-us.w4-x .tap-c4 { visibility: collapse; }
#tap-us.w4-xs .tap-c4 { width: 50px; }
#tap-us.w4-s .tap-c4 { width: 70px; }
#tap-us.w4-m .tap-c4 { width: 120px; }
#tap-us.w4-l .tap-c4 { width: 164px; }
#tap-us.w4-xl .tap-c4 { width: 230px; }
#tap-us.w5-x .tap-c5 { visibility: collapse; }
#tap-us.w5-xs .tap-c5 { width: 50px; }
#tap-us.w5-s .tap-c5 { width: 70px; }
#tap-us.w5-m .tap-c5 { width: 120px; }
#tap-us.w5-l .tap-c5 { width: 164px; }
#tap-us.w5-xl .tap-c5 { width: 230px; }
#tap-us.w6-x .tap-c6 { visibility: collapse; }
#tap-us.w6-xs .tap-c6 { width: 50px; }
#tap-us.w6-s .tap-c6 { width: 70px; }
#tap-us.w6-m .tap-c6 { width: 120px; }
#tap-us.w6-l .tap-c6 { width: 164px; }
#tap-us.w6-xl .tap-c6 { width: 230px; }
#tap-us.w7-x .tap-c7 { visibility: collapse; }
#tap-us.w7-xs .tap-c7 { width: 50px; }
#tap-us.w7-s .tap-c7 { width: 70px; }
#tap-us.w7-m .tap-c7 { width: 120px; }
#tap-us.w7-l .tap-c7 { width: 164px; }
#tap-us.w7-xl .tap-c7 { width: 230px; }
#tap-us.w8-x .tap-c8 { visibility: collapse; }
#tap-us.w8-xs .tap-c8 { width: 50px; }
#tap-us.w8-s .tap-c8 { width: 70px; }
#tap-us.w8-m .tap-c8 { width: 120px; }
#tap-us.w8-l .tap-c8 { width: 164px; }
#tap-us.w8-xl .tap-c8 { width: 230px; }
#tap-us.w9-x .tap-c9 { visibility: collapse; }
#tap-us.w9-xs .tap-c9 { width: 50px; }
#tap-us.w9-s .tap-c9 { width: 70px; }
#tap-us.w9-m .tap-c9 { width: 120px; }
#tap-us.w9-l .tap-c9 { width: 164px; }
#tap-us.w9-xl .tap-c9 { width: 230px; }

/* ---- list ---- */
#tap-ls {
	flow-children: right;
}

.tap-ls-col {
	flow-children: down;
	width: 440px;
	margin-right: 20px;
}

.tap-ls-col:last-child {
	margin-right: 0px;
}

/* One framed row per item: the command and its favorite star share the frame (two buttons, no nesting,
 * since a hit-testable child would take the parent button's click). */
/* 9 rows x 54 + 8 x 8 gaps = 550; the form beside the list uses the same height. */
.tap-irow {
	flow-children: right;
	width: 440px;
	height: 54px;
	margin-bottom: 8px;
	background-color: #2e3c50;
	border: 1px solid #ffffff14;
	overflow: noclip noclip;
}

.tap-item {
	width: fill-parent-flow( 1.0 );
	height: 100%;
	overflow: noclip noclip;
}

/* Label block, centered as a whole: one line, or the chat command above the label on command items. */
.tap-item-in {
	width: 100%;
	flow-children: down;
	vertical-align: center;
}

.tap-item-c {
	visibility: collapse;
	margin-left: 16px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #7d8791;
	white-space: nowrap;
}

.tap-item.tap-cmd .tap-item-c {
	visibility: visible;
}

.tap-item:hover .tap-item-c {
	color: #ffeaa8;
}

.tap-item:hover {
	background-color: #41567a;
}

.tap-item-t {
	margin-left: 16px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 17px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 11px ) ellipsis;
}

.tap-item:hover .tap-item-t {
	color: #ffeaa8;
}

/* Favorite toggle at the right end of the row. */
.tap-star {
	width: 48px;
	height: 100%;
}

.tap-star:hover {
	background-color: #41567a99;
}

.tap-star-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 22px;
	color: #5c6670;
}

.tap-star:hover .tap-star-t {
	color: #ffeaa8;
}

.tap-star.tap-fav .tap-star-t {
	color: #ffde85;
}

/* Open command: the second list column gives way to the form. */
#tap-fm {
	visibility: collapse;
}

#tap-ls.tap-form #tap-fm {
	visibility: visible;
}

#tap-ls.tap-form #tap-ls2 {
	visibility: collapse;
}

.tap-item.tap-on {
	background-color: #41567a;
}

.tap-item.tap-on .tap-item-t {
	color: #ffeaa8;
}

/* ---- command form ---- */
/* Two layers: the fields from the top, the command line and execute button pinned to the bottom. */
/* Same 440 as the list column it replaces; content 410 after the padding. */
/* Ends on the same line as the 9-row list beside it (9 x 54 + 8 x 8 = 550); 550 came out 1-2px short in game. */
.tap-fm {
	flow-children: none;
	width: 440px;
	height: 552px;
	padding: 0px 15px;
	background-color: #1a2330cc;
	border-top: 3px solid #ffde85;
	overflow: noclip noclip;
}

.tap-fm-top {
	flow-children: down;
	width: 410px;
	margin-top: 10px;
}

.tap-fm-foot {
	flow-children: down;
	width: 410px;
	margin-bottom: 12px;
	vertical-align: bottom;
}

.tap-fm-head {
	flow-children: right;
	width: 410px;
	margin-bottom: 6px;
}

.tap-fm-name {
	flow-children: down;
	width: fill-parent-flow( 1.0 );
}

.tap-fm-c {
	font-family: Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #7d8791;
	white-space: nowrap;
}

.tap-fm-t {
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 20px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 12px ) ellipsis;
}

.tap-fm-d {
	width: 410px;
	margin-bottom: 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #9aa4af;
}

/* Usage line of the open command, e.g. "Usage: !slap <player> [damage]". */
.tap-fm-u {
	width: 410px;
	margin-bottom: 4px;
	padding: 3px 8px;
	background-color: #00000059;
	border-left: 3px solid #3ec9ff;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #c5ccd3;
	white-space: nowrap;
	text-overflow: shrink min( 9px ) ellipsis;
}

.tap-fm-close {
	width: 30px;
	height: 30px;
}

.tap-fm-close:hover {
	background-color: #41567a99;
}

.tap-fm-close-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 16px;
	color: #9aa4af;
}

.tap-fm-close:hover .tap-fm-close-t {
	color: #ffeaa8;
}

/* One argument: heading, then a box with the current value and the open / closed mark. */
.tap-field {
	flow-children: down;
	width: 410px;
	margin-top: 6px;
	overflow: noclip noclip;
}

.tap-field-k {
	margin-bottom: 2px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 9px ) ellipsis;
}

/* The value label leaves 30px on the right for the mark, which overlays it. */
.tap-field-box {
	flow-children: none;
	width: 410px;
	height: 28px;
	background-color: #2e3c50;
	border: 1px solid #ffffff14;
}

.tap-field:hover .tap-field-box {
	background-color: #41567a;
}

.tap-field-v {
	width: 370px;
	margin-left: 10px;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 15px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-field-a {
	horizontal-align: right;
	vertical-align: center;
	margin-right: 10px;
	font-size: 12px;
	color: #7d8791;
}

/* Value not chosen yet (required) / left at the default (optional). */
.tap-field.tap-empty .tap-field-v {
	color: #6b747d;
}

.tap-field.tap-open .tap-field-box {
	background-color: #41567a;
	border: 1px solid #ffde8559;
}

.tap-field.tap-open .tap-field-k {
	color: #ffde85;
}

.tap-field.tap-wait .tap-field-box {
	border: 1px solid #3ec9ff;
}

.tap-field.tap-wait .tap-field-v {
	color: #3ec9ff;
}

/* Choice grid under the open field: 3 rows x 4, paged. */
.tap-pk {
	flow-children: down;
	width: 410px;
	padding: 4px 0px 2px 0px;
	visibility: collapse;
}

.tap-pk.tap-show {
	visibility: visible;
}

.tap-pk-row {
	flow-children: right;
	width: 410px;
}

/* Cells share the row width (fill-parent-flow) instead of a fixed width. */
.tap-pc {
	width: fill-parent-flow( 1.0 );
	height: 26px;
	margin: 3px 3px 0px 0px;
	background-color: #222d3c;
}

.tap-pc:last-child {
	margin-right: 0px;
}

/* Spacer past the last choice: keeps its share of the row but is not drawn. */
.tap-pc.tap-void {
	opacity: 0;
}

.tap-pc:hover {
	background-color: #41567a;
}

.tap-pc-t {
	horizontal-align: center;
	vertical-align: center;
	margin: 0px 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 9px ) ellipsis;
}

.tap-pc:hover .tap-pc-t {
	color: #ffeaa8;
}

/* The value the field has now. */
.tap-pc.tap-sel {
	background-color: #ffde852e;
}

.tap-pc.tap-sel .tap-pc-t {
	color: #ffde85;
}

.tap-pk-pager {
	flow-children: right;
	width: fit-children;
	height: 24px;
	margin-top: 3px;
	horizontal-align: right;
}

.tap-pk-btn {
	width: 28px;
	height: 24px;
	background-color: #222d3c;
}

.tap-pk-btn:hover {
	background-color: #41567a;
}

.tap-pk-btn-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 16px;
	color: #c5ccd3;
}

.tap-pk-page {
	vertical-align: center;
	margin: 0px 8px;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #9aa4af;
}

/* How the command will be typed, with the players it hits right now. */
.tap-fm-line {
	width: 410px;
	padding: 6px 10px;
	background-color: #00000059;
	border-left: 3px solid #3ec9ff;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-fm-tg {
	width: 410px;
	margin-bottom: 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #9aa4af;
}

.tap-fx {
	margin-top: 8px;
	padding: 6px 36px;
	horizontal-align: right;
}

.tap-fx .lu-btn-t {
	font-size: 17px;
}

/* Required fields missing. */
.tap-fx.tap-dis {
	background-color: #2e3c5066;
	border: 1px solid #ffffff14;
}

.tap-fx.tap-dis .lu-btn-t {
	color: #6b747d;
}

.tap-fx.tap-dis:hover {
	background-color: #2e3c5066;
	border: 1px solid #ffffff14;
}

.tap-fx.tap-dis:hover .lu-btn-t {
	color: #6b747d;
}

/* ---- footer ---- */
.tap-foot {
	width: 900px;
	height: 36px;
	margin: 12px 0px 12px 0px;
	padding-top: 8px;
	border-top: 1px solid #ffffff14;
}

.tap-hint {
	horizontal-align: center;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #6b747d;
}

.tap-pager {
	flow-children: right;
	width: fit-children;
	horizontal-align: right;
}

.tap-fbtn {
	padding: 4px 16px;
}

.tap-page {
	vertical-align: center;
	margin: 0px 12px;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
}
