.ico-watch .tap-si-i, .ico-watch .tap-sbtn-i { background-image: url("s2r://panorama/images/icons/ui/watch.vsvg"); }
.ico-watch_tv .tap-si-i, .ico-watch_tv .tap-sbtn-i { background-image: url("s2r://panorama/images/icons/ui/watch_tv.vsvg"); }
.ico-zoom_in .tap-si-i, .ico-zoom_in .tap-sbtn-i { background-image: url("s2r://panorama/images/icons/ui/zoom_in.vsvg"); }

/* ---- main ---- */
.tap-main {
	flow-children: down;
	width: 940px;
	height: 100%;
	padding: 0px 20px;
}

.tap-head {
	flow-children: right;
	width: 900px;
	margin-top: 16px;
	padding-bottom: 10px;
	margin-bottom: 12px;
	border-bottom: 1px solid #ffffff14;
}

.tap-head-l {
	flow-children: down;
	width: fill-parent-flow( 1.0 );
}

/* Breadcrumb under the title, on every page. */
.tap-bc {
	flow-children: right;
	margin-top: 2px;
	height: 18px;
}

.tap-bcl-t, .tap-bcs, .tap-bcc {
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	white-space: nowrap;
}

.tap-bcl-t {
	color: #ffde85;
}

.tap-bcl:hover .tap-bcl-t {
	color: #ffeaa8;
	text-decoration: underline;
}

.tap-bcs {
	margin: 0px 8px;
	color: #6b747d;
}

.tap-bcc {
	color: #9aa4af;
}

.tap-title {
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 22px;
	color: #f4f6f8;
	text-overflow: shrink min( 12px ) ellipsis;
	white-space: nowrap;
}

/* The page's note after the breadcrumb. */
.tap-sub {
	vertical-align: center;
	margin-left: 14px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #6b747d;
	text-overflow: shrink min( 10px ) ellipsis;
	white-space: nowrap;
}

/* Takes whatever height the header and footer leave, so the card has no empty band at the bottom. */
.tap-sec {
	flow-children: down;
	width: 900px;
	height: fill-parent-flow( 1.0 );
}

/* ---- overview ---- */
.tap-ov-row {
	flow-children: right;
	width: 900px;
	margin-bottom: 12px;
}

/* 4 x 216 + 3 x 12 = 900. */
.tap-stat {
	flow-children: down;
	width: 216px;
	height: 96px;
	margin-right: 12px;
	padding: 12px 14px;
	background-color: #2e3c50cc;
	border: 1px solid #ffffff14;
	border-left: 3px solid #ffde85;
}

.tap-stat:last-child {
	margin-right: 0px;
}

.tap-stat-k {
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-stat-v {
	margin-top: 8px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 26px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 12px ) ellipsis;
}

/* ---- player details ---- */
/* Two columns of 444 + 12 = 900. */
.tap-dt-cols {
	flow-children: right;
	width: 900px;
	height: fill-parent-flow( 1.0 );
}

.tap-dt-col {
	flow-children: down;
	width: 444px;
	margin-right: 12px;
}

.tap-dt-col:last-child {
	margin-right: 0px;
}

/* A heading, then label / value rows. Content 420 after the padding and the left border. */
.tap-dgroup {
	flow-children: down;
	width: 444px;
	margin-bottom: 12px;
	padding: 8px 12px 6px 9px;
	background-color: #2e3c50cc;
	border: 1px solid #ffffff14;
	border-left: 3px solid #ffde85;
}

.tap-dgroup-h {
	margin-bottom: 4px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 14px;
	letter-spacing: 1px;
	color: #ffde85;
}

.tap-drow {
	flow-children: right;
	width: 420px;
	height: 26px;
	border-top: 1px solid #ffffff0d;
}

.tap-drow-k {
	width: 130px;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-drow-v {
	width: 290px;
	vertical-align: center;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 15px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

/* ---- dev ---- */
/* A module's dependencies: as high as its rows, up to the right column's height (552), then the list scrolls; the
   page bar under it. Rows 12 narrower than the box for the scroll bar. */
.tap-dvd {
	height: fit-children;
	max-height: 552px;
	margin-bottom: 0px;
}

/* 470 = 552 less the box's padding and border (16), the heading (22) and the page bar (42). */
.tap-dvdscroll {
	flow-children: down;
	width: 420px;
	height: fit-children;
	max-height: 470px;
}

.tap-dvd .tap-drow {
	width: 408px;
}

.tap-dvd .tap-drow-k {
	width: 290px;
	font-size: 14px;
	color: #f4f6f8;
}

.tap-dvd .tap-drow-v {
	width: 118px;
	text-align: right;
	font-size: 14px;
	color: #c5ccd3;
}

.tap-dvd .tap-lbar {
	width: 408px;
}

.tap-mlist .tap-lbar {
	width: 862px;
}

/* Plugins: one box with a header row and the scrolling rows below, down to the bottom. */
.tap-mlist {
	flow-children: down;
	width: 900px;
	height: fill-parent-flow( 1.0 );
	margin-bottom: 12px;
	padding: 6px 12px 6px 9px;
	background-color: #2e3c50cc;
	border: 1px solid #ffffff14;
	border-left: 3px solid #ffde85;
}

.tap-mscroll {
	flow-children: down;
	width: 100%;
	height: fill-parent-flow( 1.0 );
}

/* Content 875 (900 less the padding and borders): 260 + 240 + 220 + 140 = 860, the rest keeps the version clear of
   the scroll bar. */
.tap-mrow {
	flow-children: right;
	width: 874px;
	height: 26px;
	border-top: 1px solid #ffffff0d;
}

.tap-mrow:hover {
	background-color: #41567a99;
}

.tap-mhead {
	border-top: 0px solid #00000000;
}

.tap-mhead:hover {
	background-color: #00000000;
}

.tap-mcell {
	vertical-align: center;
	padding-left: 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #c5ccd3;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-mc0 {
	width: 260px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	color: #f4f6f8;
}

.tap-mc1 {
	width: 240px;
}

.tap-mc2 {
	width: 220px;
}

.tap-mc3 {
	width: 140px;
	text-align: right;
}

.tap-mrow:hover .tap-mc0 {
	color: #ffeaa8;
}

.tap-mhead .tap-mcell {
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 13px;
	letter-spacing: 1px;
	color: #ffde85;
}

/* ---- users table ---- */
.tap-urow {
	flow-children: right;
	width: 900px;
	height: 26px;
	padding: 0px 6px;
	overflow: noclip noclip;
}

/* The rows under the header; 12 narrower than it for the scroll bar (the columns line up from the left). */
.tap-uscroll {
	flow-children: down;
	width: 900px;
	height: fill-parent-flow( 1.0 );
}

.tap-uscroll .tap-urow {
	width: 888px;
}

Button.tap-urow:hover {
	background-color: #41567a99;
}

.tap-urow:nth-child(odd) {
	background-color: #ffffff08;
}

.tap-urow.tap-uhead {
	height: 30px;
	border-bottom: 1px solid #ffffff1f;
	background-color: #00000000;
}

.tap-cell {
	width: 120px;
	vertical-align: center;
	padding-right: 8px;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

/* Header cells: same pitch as the data cells, but the hover box is inset 4px on both sides of the text
 * (shifted left by 4px and padded back) instead of hanging the cell's 8px right gap off the text. */
.tap-hcell {
	height: 24px;
	vertical-align: center;
	margin: 0px 4px 0px -4px;
	padding: 0px 4px;
}

.tap-hcell-t {
	width: 100%;
	vertical-align: center;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-hcell.tap-sortable:hover {
	background-color: #41567a66;
}

.tap-hcell.tap-sortable:hover .tap-hcell-t {
	color: #ffeaa8;
}

.tap-hcell.tap-sorted .tap-hcell-t {
	color: #ffde85;
}

Button.tap-urow:hover .tap-cell {
	color: #ffeaa8;
}

/* Column width ladder: set on #tap-us as w{slot}-{x|xs|s|m|l|xl}. id + class beats .tap-cell. */
#tap-us.w0-x .tap-c0 { visibility: collapse; }
#tap-us.w0-xs .tap-c0 { width: 50px; }
#tap-us.w0-s .tap-c0 { width: 70px; }
#tap-us.w0-m .tap-c0 { width: 120px; }
#tap-us.w0-l .tap-c0 { width: 164px; }
#tap-us.w0-xl .tap-c0 { width: 230px; }
#tap-us.w1-x .tap-c1 { visibility: collapse; }
#tap-us.w1-xs .tap-c1 { width: 50px; }
#tap-us.w1-s .tap-c1 { width: 70px; }
#tap-us.w1-m .tap-c1 { width: 120px; }
#tap-us.w1-l .tap-c1 { width: 164px; }
#tap-us.w1-xl .tap-c1 { width: 230px; }
#tap-us.w2-x .tap-c2 { visibility: collapse; }
#tap-us.w2-xs .tap-c2 { width: 50px; }
#tap-us.w2-s .tap-c2 { width: 70px; }
#tap-us.w2-m .tap-c2 { width: 120px; }
#tap-us.w2-l .tap-c2 { width: 164px; }
#tap-us.w2-xl .tap-c2 { width: 230px; }
#tap-us.w3-x .tap-c3 { visibility: collapse; }
#tap-us.w3-xs .tap-c3 { width: 50px; }
#tap-us.w3-s .tap-c3 { width: 70px; }
#tap-us.w3-m .tap-c3 { width: 120px; }
#tap-us.w3-l .tap-c3 { width: 164px; }
#tap-us.w3-xl .tap-c3 { width: 230px; }
#tap-us.w4-x .tap-c4 { visibility: collapse; }
#tap-us.w4-xs .tap-c4 { width: 50px; }
#tap-us.w4-s .tap-c4 { width: 70px; }
#tap-us.w4-m .tap-c4 { width: 120px; }
#tap-us.w4-l .tap-c4 { width: 164px; }
#tap-us.w4-xl .tap-c4 { width: 230px; }
#tap-us.w5-x .tap-c5 { visibility: collapse; }
#tap-us.w5-xs .tap-c5 { width: 50px; }
#tap-us.w5-s .tap-c5 { width: 70px; }
#tap-us.w5-m .tap-c5 { width: 120px; }
#tap-us.w5-l .tap-c5 { width: 164px; }
#tap-us.w5-xl .tap-c5 { width: 230px; }
#tap-us.w6-x .tap-c6 { visibility: collapse; }
#tap-us.w6-xs .tap-c6 { width: 50px; }
#tap-us.w6-s .tap-c6 { width: 70px; }
#tap-us.w6-m .tap-c6 { width: 120px; }
#tap-us.w6-l .tap-c6 { width: 164px; }
#tap-us.w6-xl .tap-c6 { width: 230px; }
#tap-us.w7-x .tap-c7 { visibility: collapse; }
#tap-us.w7-xs .tap-c7 { width: 50px; }
#tap-us.w7-s .tap-c7 { width: 70px; }
#tap-us.w7-m .tap-c7 { width: 120px; }
#tap-us.w7-l .tap-c7 { width: 164px; }
#tap-us.w7-xl .tap-c7 { width: 230px; }
#tap-us.w8-x .tap-c8 { visibility: collapse; }
#tap-us.w8-xs .tap-c8 { width: 50px; }
#tap-us.w8-s .tap-c8 { width: 70px; }
#tap-us.w8-m .tap-c8 { width: 120px; }
#tap-us.w8-l .tap-c8 { width: 164px; }
#tap-us.w8-xl .tap-c8 { width: 230px; }
#tap-us.w9-x .tap-c9 { visibility: collapse; }
#tap-us.w9-xs .tap-c9 { width: 50px; }
#tap-us.w9-s .tap-c9 { width: 70px; }
#tap-us.w9-m .tap-c9 { width: 120px; }
#tap-us.w9-l .tap-c9 { width: 164px; }
#tap-us.w9-xl .tap-c9 { width: 230px; }

/* ---- list ---- */
/* The list column, then the hint or the form, full height. */
#tap-ls {
	flow-children: right;
}

/* The search box (search tab), the list and its page bar. 452 = rows 440 + 12 for the scroll bar; then 8 + the form 440 = 900. */
.tap-lcol {
	flow-children: down;
	width: 452px;
	height: 552px;
	margin-right: 8px;
}

/* ---- search box ---- */
/* The field and clear share a frame the size of a command row (440 x 54, the same gap under it) above the list;
   clear sits where the star is. Darker than the rows with a lighter frame, so it reads as a sunken text field; gold
   frame while waiting for chat. Search tab only; the gap only while shown. */
.tap-sbox {
	visibility: collapse;
	flow-children: right;
	width: 440px;
	height: 54px;
	background-color: #141b26;
	border: 1px solid #ffffff33;
}

#tap-ls.tap-search .tap-sbox {
	visibility: visible;
	margin-bottom: 8px;
}

.tap-sbox:hover {
	border: 1px solid #ffffff55;
}

.tap-sbox.tap-wait, .tap-sbox.tap-wait:hover {
	border: 1px solid #ffde85;
}

/* Looks like a text field; a button that starts / stops the chat input. */
.tap-sfield {
	width: fill-parent-flow( 1.0 );
	height: 100%;
	padding: 0px 16px;
}

.tap-sfield:hover {
	background-color: #ffffff08;
}

.tap-sfield.tap-wait {
	background-color: #ffde850f;
}

.tap-sfield-t {
	width: 100%;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 17px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 11px ) ellipsis;
}

/* Placeholder, or waiting for chat. */
.tap-sfield.tap-empty .tap-sfield-t {
	color: #6b747d;
}

.tap-sfield.tap-wait .tap-sfield-t {
	color: #ffde85;
}

.tap-sclear {
	width: 48px;
	height: 100%;
}

.tap-sclear:hover {
	background-color: #ffffff0d;
}

.tap-sclear-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 18px;
	color: #5c6670;
}

.tap-sclear:hover .tap-sclear-t {
	color: #ffde85;
}


/* What the page bar leaves. */
.tap-lscroll {
	flow-children: down;
	width: 452px;
	height: fill-parent-flow( 1.0 );
}

/* Page bar under a scrolling list (commands, modules, dependencies), as wide as its rows: Previous | page | Next.
   Tinted with a gold hover like the sidebar's Previous / Next. Only with more than one page. */
.tap-lbar {
	flow-children: right;
	width: 440px;
	height: 38px;
	margin-top: 4px;
	background-color: #ffffff0a;
	border-top: 1px solid #ffffff14;
}

.tap-lbtn {
	width: 140px;
	height: 100%;
	padding: 0px 14px;
}

.tap-lbtn:hover {
	background-color: #ffde8514;
}

.tap-lbtn-t {
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #9aa4af;
	white-space: nowrap;
}

.tap-lbtn-next .tap-lbtn-t {
	horizontal-align: right;
}

.tap-lbtn:hover .tap-lbtn-t {
	color: #ffde85;
}

/* No page that way: dim, no hover. */
.tap-lbtn.tap-dis, .tap-lbtn.tap-dis:hover {
	background-color: #00000000;
}

.tap-lbtn.tap-dis .tap-lbtn-t, .tap-lbtn.tap-dis:hover .tap-lbtn-t {
	color: #9aa4af33;
}

.tap-lpage {
	width: fill-parent-flow( 1.0 );
	vertical-align: center;
	text-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #c5ccd3;
}

/* One framed row per item: the command and its favorite star share the frame (two buttons, no nesting,
 * since a hit-testable child would take the parent button's click). */
/* 54 high with 8 between, the form beside the list as high as the visible part. */
.tap-irow {
	flow-children: right;
	width: 440px;
	height: 54px;
	margin-bottom: 8px;
	background-color: #2e3c50;
	border: 1px solid #ffffff14;
	overflow: noclip noclip;
}

.tap-item {
	width: fill-parent-flow( 1.0 );
	height: 100%;
	overflow: noclip noclip;
}

/* Label block, centered as a whole: one line, or the chat command above the label on command items. */
.tap-item-in {
	width: 100%;
	flow-children: down;
	vertical-align: center;
}

.tap-item-c {
	visibility: collapse;
	margin-left: 16px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #7d8791;
	white-space: nowrap;
}

.tap-item.tap-cmd .tap-item-c {
	visibility: visible;
}

.tap-item:hover .tap-item-c {
	color: #ffeaa8;
}

.tap-item:hover {
	background-color: #41567a;
}

.tap-item-t {
	margin-left: 16px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 17px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 11px ) ellipsis;
}

.tap-item:hover .tap-item-t {
	color: #ffeaa8;
}

/* Favorite toggle at the right end of the row. */
.tap-star {
	width: 48px;
	height: 100%;
}

.tap-star:hover {
	background-color: #41567a99;
}

.tap-star-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 22px;
	color: #5c6670;
}

.tap-star:hover .tap-star-t {
	color: #ffeaa8;
}

.tap-star.tap-fav .tap-star-t {
	color: #ffde85;
}

/* Open command: the form, else the hint in its place. */
#tap-fm {
	visibility: collapse;
}

#tap-ls.tap-form #tap-fm {
	visibility: visible;
}

#tap-ls.tap-form #tap-fh {
	visibility: collapse;
}

.tap-fh {
	width: 440px;
	height: 552px;
	background-color: #1a233066;
	border: 1px solid #ffffff0d;
}

.tap-fh-t {
	horizontal-align: center;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 15px;
	color: #6b747d;
}

.tap-item.tap-on {
	background-color: #41567a;
}

.tap-item.tap-on .tap-item-t {
	color: #ffeaa8;
}

/* ---- command form ---- */
/* Two layers: the fields from the top, the command line and execute button pinned to the bottom. */
/* 440 wide, content 410 after the padding. 552 high like the list column beside it (550 came out 1-2px short in
   game against the old 9-row list). */
.tap-fm {
	flow-children: none;
	width: 440px;
	height: 552px;
	padding: 0px 15px;
	background-color: #1a2330cc;
	border-top: 3px solid #ffde85;
	overflow: noclip noclip;
}

.tap-fm-top {
	flow-children: down;
	width: 410px;
	margin-top: 10px;
}

.tap-fm-foot {
	flow-children: down;
	width: 410px;
	margin-bottom: 12px;
	vertical-align: bottom;
}

.tap-fm-head {
	flow-children: right;
	width: 410px;
	margin-bottom: 6px;
}

.tap-fm-name {
	flow-children: down;
	width: fill-parent-flow( 1.0 );
}

.tap-fm-c {
	font-family: Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #7d8791;
	white-space: nowrap;
}

.tap-fm-t {
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 20px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 12px ) ellipsis;
}

.tap-fm-d {
	width: 410px;
	margin-bottom: 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #9aa4af;
}

/* Usage line of the open command, e.g. "Usage: !slap <player> [damage]". */
.tap-fm-u {
	width: 410px;
	margin-bottom: 4px;
	padding: 3px 8px;
	background-color: #00000059;
	border-left: 3px solid #3ec9ff;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #c5ccd3;
	white-space: nowrap;
	text-overflow: shrink min( 9px ) ellipsis;
}

.tap-fm-close {
	width: 30px;
	height: 30px;
}

.tap-fm-close:hover {
	background-color: #41567a99;
}

.tap-fm-close-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 16px;
	color: #9aa4af;
}

.tap-fm-close:hover .tap-fm-close-t {
	color: #ffeaa8;
}

/* One argument: heading, then a box with the current value and the open / closed mark. */
.tap-field {
	flow-children: down;
	width: 410px;
	margin-top: 6px;
	overflow: noclip noclip;
}

.tap-field-k {
	margin-bottom: 2px;
	font-family: Stratum2 Bold, Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #9aa4af;
	white-space: nowrap;
	text-overflow: shrink min( 9px ) ellipsis;
}

/* The value label leaves 30px on the right for the mark, which overlays it. */
.tap-field-box {
	flow-children: none;
	width: 410px;
	height: 28px;
	background-color: #2e3c50;
	border: 1px solid #ffffff14;
}

.tap-field:hover .tap-field-box {
	background-color: #41567a;
}

.tap-field-v {
	width: 370px;
	margin-left: 10px;
	vertical-align: center;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 15px;
	color: #f4f6f8;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-field-a {
	horizontal-align: right;
	vertical-align: center;
	margin-right: 10px;
	font-size: 12px;
	color: #7d8791;
}

/* Value not chosen yet (required) / left at the default (optional). */
.tap-field.tap-empty .tap-field-v {
	color: #6b747d;
}

.tap-field.tap-open .tap-field-box {
	background-color: #41567a;
	border: 1px solid #ffde8559;
}

.tap-field.tap-open .tap-field-k {
	color: #ffde85;
}

.tap-field.tap-wait .tap-field-box {
	border: 1px solid #3ec9ff;
}

.tap-field.tap-wait .tap-field-v {
	color: #3ec9ff;
}

/* Choice grid under the open field: 3 rows x 4, paged. */
.tap-pk {
	flow-children: down;
	width: 410px;
	padding: 4px 0px 2px 0px;
	visibility: collapse;
}

.tap-pk.tap-show {
	visibility: visible;
}

/* Three rows (3 x 29) visible, the rest scrolled; rows 12 narrower for the scroll bar. */
.tap-pkscroll {
	flow-children: down;
	width: 410px;
	height: fit-children;
	max-height: 88px;
}

.tap-pk-row {
	flow-children: right;
	width: 398px;
}

/* Cells share the row width (fill-parent-flow) instead of a fixed width. */
.tap-pc {
	width: fill-parent-flow( 1.0 );
	height: 26px;
	margin: 3px 3px 0px 0px;
	background-color: #222d3c;
}

.tap-pc:last-child {
	margin-right: 0px;
}

/* Spacer past the last choice: keeps its share of the row but is not drawn. */
.tap-pc.tap-void {
	opacity: 0;
}

.tap-pc:hover {
	background-color: #41567a;
}

.tap-pc-t {
	horizontal-align: center;
	vertical-align: center;
	margin: 0px 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 9px ) ellipsis;
}

.tap-pc:hover .tap-pc-t {
	color: #ffeaa8;
}

/* The value the field has now. */
.tap-pc.tap-sel {
	background-color: #ffde852e;
}

.tap-pc.tap-sel .tap-pc-t {
	color: #ffde85;
}

.tap-pk-pager {
	flow-children: right;
	width: fit-children;
	height: 24px;
	margin-top: 3px;
	horizontal-align: right;
}

.tap-pk-btn {
	width: 28px;
	height: 24px;
	background-color: #222d3c;
}

.tap-pk-btn:hover {
	background-color: #41567a;
}

.tap-pk-btn-t {
	horizontal-align: center;
	vertical-align: center;
	font-size: 16px;
	color: #c5ccd3;
}

.tap-pk-page {
	vertical-align: center;
	margin: 0px 8px;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 12px;
	color: #9aa4af;
}

/* How the command will be typed, with the players it hits right now. */
.tap-fm-line {
	width: 410px;
	padding: 6px 10px;
	background-color: #00000059;
	border-left: 3px solid #3ec9ff;
	font-family: Stratum2 Regular Monodigit, Stratum2, Arial, sans-serif;
	font-size: 14px;
	color: #e6e9ed;
	white-space: nowrap;
	text-overflow: shrink min( 10px ) ellipsis;
}

.tap-fm-tg {
	width: 410px;
	margin-bottom: 4px;
	font-family: Stratum2, Arial, sans-serif;
	font-size: 13px;
	color: #9aa4af;
}

.tap-fx {
	margin-top: 8px;
	padding: 6px 36px;
	horizontal-align: right;
}

.tap-fx .lu-btn-t {
	font-size: 17px;
}

/* Required fields missing. */
.tap-fx.tap-dis {
	background-color: #2e3c5066;
	border: 1px solid #ffffff14;
}

.tap-fx.tap-dis .lu-btn-t {
	color: #6b747d;
}

.tap-fx.tap-dis:hover {
	background-color: #2e3c5066;
	border: 1px solid #ffffff14;
}

.tap-fx.tap-dis:hover .lu-btn-t {
	color: #6b747d;
}

